---
interface Props {
  direction?: 'right' | 'left' | 'down';
  size?: number;
}

const { direction = 'right', size = 18 } = Astro.props;
const rotation = direction === 'left' ? 180 : direction === 'down' ? 90 : 0;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  style={`transform: rotate(${rotation}deg)`}
>
  <path d="M5 12h14M14 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
